# ---------------------------------------------------------------------------
# Haryn AI — environment variables
# Copy to `.env.local` and fill in what you need. Nothing here is required to
# boot the app; the sample report works with no configuration at all.
# ---------------------------------------------------------------------------

# ---- Database -------------------------------------------------------------
# Reports are stored so they survive a restart and can be shared by link.
#
# Local development uses SQLite through Node's built-in driver (node:sqlite),
# so there is no database server and no native dependency to install. The file
# is created automatically, along with its directory.
DATABASE_FILE="./data/haryn.db"
#
# Production is expected to run PostgreSQL. Point a Postgres-backed
# implementation of lib/store.ts at it — the DDL in lib/db.ts is written in
# portable SQL for exactly that reason. Set DATABASE_URL when you do:
# DATABASE_URL="postgresql://user:password@localhost:5432/haryn_ai"

# Optional — and usually unnecessary.
# Repositories are fetched as tarballs from codeload.github.com, which has no
# rate limit, so analyses work with no configuration at all. The REST API is
# only used for optional metadata (stars, forks, licence, dates); when it is
# rate-limited, that metadata is derived from the archive instead.
# A classic personal access token with no scopes enriches the report header.
GITHUB_TOKEN=

# Optional. Defaults to the public GitHub API.
GITHUB_API_URL=https://api.github.com

# ---- AI layer (optional) --------------------------------------------------
# Everything below is optional. With no key, retrieval and answers still work
# entirely offline: the repository is indexed with BM25 + structural signals,
# the matched code is read for roles, call flow and dependencies, and every
# answer cites the file:line it came from.
#
# With one or more keys you additionally get:
#   • a written, reasoned repository summary
#   • fluent, reasoned answers to questions about the code
#   • a semantic embedding blend on top of lexical retrieval
#
# ---- Multiple providers with automatic failover ---------------------------
# Set as many of these as you like. Answers are tried against them in order and
# the first that responds wins. A provider that returns 429 (rate limited), 402
# (quota), 401/403 (bad key) or 5xx is parked for a while and skipped, so one
# exhausted free tier does not take the assistant offline.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Any OpenAI-compatible server: Ollama, vLLM, LM Studio, Together, DeepSeek.
# Needs no key when CUSTOM_BASE_URL is set.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# Optional per-provider model overrides.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: control which provider is tried first. Accepts ids or aliases:
#   openai · anthropic (claude) · google (gemini) · groq · openrouter · custom
# Anything omitted is appended afterward, so adding a key is enough to use it.
# AI_PROVIDER_ORDER=groq,gemini,anthropic,openai

# Optional: pin each provider to a custom endpoint (proxies, Azure, gateways).
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GEMINI_BASE_URL=
GROQ_BASE_URL=
OPENROUTER_BASE_URL=

# ---- Single-provider shorthand (legacy, still supported) ------------------
# AI_API_KEY works as an OpenAI-compatible key when no specific one is set.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

AI_EMBEDDING_MODEL=text-embedding-3-small
# Set to "off" to keep chat but skip embedding calls (saves quota).
AI_EMBEDDINGS=on

# ---- Analysis limits (TRD §10 / §33) --------------------------------------
MAX_REPOSITORY_SIZE_MB=250
MAX_FILES=10000
MAX_FILE_SIZE_MB=1
ANALYSIS_TIMEOUT_SECONDS=600
# Wall-clock budget for downloading the repository archive. Large public repos
# are real: amzn/selling-partner-api-samples is an 89 MB tarball (~39 s on a good
# connection), so a tight budget aborts it the moment the link is slower.
ARCHIVE_TIMEOUT_SECONDS=180

# ---- Abuse protection (TRD §34) -------------------------------------------
# Analyses per IP per hour, and AI-chat requests per IP per hour.
RATE_LIMIT_ANALYSIS=10
RATE_LIMIT_CHAT=60
