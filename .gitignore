# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database (SQLite via node:sqlite)
/data/

# verification harness output — regenerate with `node scripts/shoot.js`
/scripts/shots/
# transient report ids written by the verification scripts
/scripts/.last-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# compiled output for the test runner (see tsconfig.test.json)
/.test-build/

# Temporary preview build output
.next-preview/
.next-preview-old/

# Local build/preview scratch
.trash-*/
build*.log
serve*.log
analyze*.ndjson

# Generated report exports — only the published PDF is tracked, so anyone can
# read it on GitHub. The per-page PNGs and older renders stay local.
reports/*
!reports/Haryn_AI_Health_Report.pdf
